{
  "name": "openlms",
  "version": "0.1.1",
  "description": "OpenLMS — local Canvas/LearningX LMS sync + search with CLI, TUI and MCP (stdio) server",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ponycompute/openlms.git"
  },
  "homepage": "https://github.com/ponycompute/openlms#readme",
  "bugs": {
    "url": "https://github.com/ponycompute/openlms/issues"
  },
  "type": "module",
  "bin": {
    "openlms": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "test": "tsx --test --test-timeout=30000 test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@napi-rs/keyring": "^2.1.2",
    "commander": "^15.0.0",
    "fflate": "^0.8.3",
    "ink": "^8.0.0",
    "react": "^19.3.1",
    "unpdf": "^1.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "keywords": [
    "openlms",
    "canvas",
    "lms",
    "learningx",
    "mcp",
    "model-context-protocol",
    "cli",
    "tui"
  ]
}
